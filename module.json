{
  "id": "forkhammer-lib",
  "title": "Forkhammer Lib",
  "description": "A shared fork of Warhammer Library for custom Foundry VTT systems.",
  "version": "3.5.1.1",
  "authors": [
    {
      "name": "Moo Man",
      "id": "Moo Man",
      "discord": "moo.man"
    },
    {
      "name": "Jeremy Glebe"
    }
  ],
  "scripts": [
    "forkhammer-lib.js"
  ],
  "styles": [
    {
      "src": "forkhammer.css",
      "layer": "system"
    }
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "library": true,
  "compatibility": {
    "minimum": "14",
    "verified": "14",
    "maximum": "14"
  },
  "relationships": {
    "systems": [
      {
        "id": "fvtt-template",
        "type": "system"
      },
      {
        "id": "rifts",
        "type": "system"
      }
    ]
  },
  "flags": {
    "hotReload": {
      "extensions": [
        "css",
        "hbs",
        "json"
      ]
    }
  },
  "socket": true,
  "url": "https://github.com/jeremyglebe/forkhammer-lib",
  "manifest": "https://github.com/jeremyglebe/forkhammer-lib/releases/latest/download/module.json",
  "download": "https://github.com/jeremyglebe/forkhammer-lib/releases/download/v3.5.1.1/forkhammer-lib.zip"
}
